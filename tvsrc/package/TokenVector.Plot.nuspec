<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>TokenVector.Plot</id>
    <version>1.0.0</version>
    <title>TokenVector.Plot - High-Performance Scientific Visualization &amp; Graphics Engine</title>
    <authors>TokenVector Project Team</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <readme>README.md</readme>
    <releaseNotes>1.0.0: Native TokenVector language (tkv) release. High-performance publication-quality 2D/3D plotting, vector graphics (SVG), coordinate transforms, publication themes (Science, Nature), colormaps (Viridis), and interoperability with TokenVector.Data.</releaseNotes>
    <description>High-performance publication-quality scientific visualization and plotting library natively implemented in the TokenVector language (tkv) and compiled to a .NET CIL DLL: line plots, scatter charts, bar plots, scientific styling themes, colormaps, coordinate transforms, and vector SVG rendering.</description>
    <tags>plot plotting visualization graphics svg charts scientific publication tokenvector</tags>
    <dependencies>
      <group targetFramework="net8.0" />
    </dependencies>
  </metadata>
</package>
