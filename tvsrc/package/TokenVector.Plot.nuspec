<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>TokenVector.Plot</id>
    <version>1.0.1</version>
    <title>TokenVector.Plot - High-Performance Scientific Visualization &amp; Graphics Engine</title>
    <authors>TokenVector Project Team</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>logo.png</icon>
    <readme>README.md</readme>
    <releaseNotes>1.0.1: Native TokenVector language (tkv) release. Features 100% pure TokenVector graphics engine: Line, Scatter, Bar Histogram, 2D Matrix Heatmap (Viridis), BoxPlot (five-number summary), Auto-Legend, and Standalone Interactive HTML cards. Full empirical competitor benchmarks against Matplotlib/Plotly, official logo integration.</releaseNotes>
    <description>High-performance publication-quality scientific visualization and plotting library natively implemented in the TokenVector language (tkv) and compiled to a .NET CIL DLL: line plots, scatter charts, bar histograms, 2D matrix heatmaps, box plots, scientific styling themes, colormaps, coordinate transforms, and vector SVG rendering.</description>
    <tags>plot plotting visualization graphics svg charts scientific publication tokenvector</tags>
    <dependencies>
      <group targetFramework="net8.0" />
    </dependencies>
  </metadata>
  <files>
    <file src="logo.png" target="" />
    <file src="README.md" target="" />
    <file src="lib/net8.0/TokenVector.Plot.dll" target="lib/net8.0/" />
  </files>
</package>
