# ----------------------------- StyleTheme -------------------------------------
class StyleTheme:
    name: "str"
    bg_color: "Color"
    plot_area_color: "Color"
    axis_color: "Color"
    grid_color: "Color"
    text_color: "Color"
    title_color: "Color"
    legend_bg: "Color"
    legend_border: "Color"
    axis_line_width: "f64"
    grid_line_width: "f64"
    show_major_grid: "i32"
    show_minor_grid: "i32"
    title_font_size: "f64"
    axis_label_font_size: "f64"
    tick_label_font_size: "f64"
    legend_font_size: "f64"
    font_family: "str"
    palette: "list[Color]"


def make_theme_science() -> "StyleTheme":
    t = StyleTheme()
    t.name = "Science"
    t.bg_color = COLOR_WHITE
    t.plot_area_color = COLOR_WHITE
    t.axis_color = color_from_hex("#111111")
    t.grid_color = color_from_hex("#E5E5E5")
    t.text_color = color_from_hex("#111111")
    t.title_color = color_from_hex("#000000")
    t.legend_bg = make_color(255, 255, 255, 230)
    t.legend_border = color_from_hex("#BDC3C7")
    t.axis_line_width = 1.2
    t.grid_line_width = 0.75
    t.show_major_grid = 1
    t.show_minor_grid = 0
    t.title_font_size = 16.0
