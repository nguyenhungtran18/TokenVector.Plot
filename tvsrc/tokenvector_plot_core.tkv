# ----------------------------- CoordinateTransform ---------------------------
# Scale Types: 0 = Linear, 1 = Log10, 2 = Ln, 3 = SymLog
SCALE_LINEAR = 0
SCALE_LOG10 = 1
SCALE_LN = 2
SCALE_SYMLOG = 3


class CoordinateTransform:
    scale: "i32"
    data_min: "f64"
    data_max: "f64"
    target_min: "f64"
    target_max: "f64"
    lin_thresh: "f64"
    lin_scale: "f64"
    trans_min: "f64"
    trans_max: "f64"
    trans_range: "f64"
    target_range: "f64"


def _forward_scalar(scale: "i32", v: "f64", lin_thresh: "f64", lin_scale: "f64") -> "f64":
    if scale == SCALE_LOG10:
        if v > 0.0:
            return log10(v)
        return -1000000.0
    if scale == SCALE_LN:
        if v > 0.0:
            return log(v)
        return -1000000.0
    if scale == SCALE_SYMLOG:
        abs_v = v
        if abs_v < 0.0:
            abs_v = -abs_v
        if abs_v <= lin_thresh:
            return (v / lin_thresh) * lin_scale
        sgn = 1.0
        if v < 0.0:
            sgn = -1.0
        return sgn * (lin_scale + log10(abs_v / lin_thresh))
    return v


def _inverse_scalar(scale: "i32", t: "f64", lin_thresh: "f64", lin_scale: "f64") -> "f64":
    if scale == SCALE_LOG10:
        return pow(10.0, t)
    if scale == SCALE_LN:
        return exp(t)
    if scale == SCALE_SYMLOG:
        abs_t = t
        if abs_t < 0.0:
            abs_t = -abs_t
        if abs_t <= lin_scale:
            return (t * lin_thresh) / lin_scale
        sgn = 1.0
        if t < 0.0:
            sgn = -1.0
        return sgn * lin_thresh * pow(10.0, abs_t - lin_scale)
    return t


def make_coord_transform(
    scale: "i32",
    data_min: "f64",
    data_max: "f64",
    target_min: "f64",
    target_max: "f64",
    lin_thresh: "f64" = 1.0,
    lin_scale: "f64" = 1.0
) -> "CoordinateTransform":
    ct = CoordinateTransform()
    ct.scale = scale
    ct.data_min = data_min
    ct.data_max = data_max
    ct.target_min = target_min
    ct.target_max = target_max
    ct.lin_thresh = lin_thresh
    ct.lin_scale = lin_scale

    t_min = _forward_scalar(scale, data_min, lin_thresh, lin_scale)
    t_max = _forward_scalar(scale, data_max, lin_thresh, lin_scale)
    ct.trans_min = t_min
    ct.trans_max = t_max
    rg = t_max - t_min
    if rg < 0.0:
        rg = -rg
    if rg < 0.000000000001:
        rg = 1.0
    ct.trans_range = rg
    ct.target_range = target_max - target_min
    return ct


def transform_to_target(ct: "CoordinateTransform", data_val: "f64") -> "f64":
    t = _forward_scalar(ct.scale, data_val, ct.lin_thresh, ct.lin_scale)
    norm = (t - ct.trans_min) / ct.trans_range
    return ct.target_min + norm * ct.target_range


def transform_to_data(ct: "CoordinateTransform", target_val: "f64") -> "f64":
    norm = (target_val - ct.target_min) / ct.target_range
    t = ct.trans_min + norm * ct.trans_range
    return _inverse_scalar(ct.scale, t, ct.lin_thresh, ct.lin_scale)


def transform_span(ct: "CoordinateTransform", inputs: "list[f64]") -> "list[f64]":
    out = []
    n = len(inputs)
    t_min = ct.trans_min
    t_range = ct.trans_range
    tgt_min = ct.target_min
    tgt_range = ct.target_range
    for i in range(n):
        val = inputs[i]
        norm = (val - t_min) / t_range
        out.append(tgt_min + norm * tgt_range)
    return out


# ----------------------------- TicksEngine ------------------------------------
class Tick:
    position: "f64"
    label: "str"
    is_major: "i32"


def make_tick(pos: "f64", label: "str", is_major: "i32" = 1) -> "Tick":
    tk = Tick()
    tk.position = pos
    tk.label = label
    tk.is_major = is_major
    return tk


def _format_tick_number(v: "f64") -> "str":
    abs_v = v
    if abs_v < 0.0:
        abs_v = -abs_v
    if abs_v < 0.00000000001:
        return "0"
    iv = int(v)
    if float(iv) == v:
        return str(iv)
    # Format float up to 3 decimals
    s = str(v)
    dot_idx = s.find(".")
    if dot_idx >= 0 and len(s) > dot_idx + 4:
        return s[:dot_idx + 4]
    return s


def ticks_generate_linear(min_val: "f64", max_val: "f64", target_count: "i32" = 6) -> "list[Tick]":
    ticks = []
    diff = max_val - min_val
    if diff < 0.0:
        diff = -diff
    if diff < 0.000000000001:
        ticks.append(make_tick(min_val, _format_tick_number(min_val), 1))
        return ticks

    lo = min_val
    hi = max_val
    if lo > hi:
        tmp = lo
        lo = hi
        hi = tmp

    raw_step = (hi - lo) / float(target_count - 1)
    # Calculate step magnitude in powers of 10
    exp_f = floor(log10(raw_step))
    p10 = pow(10.0, exp_f)
    base_step = raw_step / p10

    chosen_base = 1.0
    if base_step > 7.0:
        chosen_base = 10.0
    elif base_step > 3.5:
        chosen_base = 5.0
    elif base_step > 1.5:
        chosen_base = 2.0
    else:
        chosen_base = 1.0

    step = chosen_base * p10
    start = floor(lo / step) * step
    end = ceil(hi / step) * step

    cur = start
    safety = 0
    while cur <= end + step * 0.01 and safety < 100:
        if cur >= lo - step * 0.01 and cur <= hi + step * 0.01:
            ticks.append(make_tick(cur, _format_tick_number(cur), 1))
        cur = cur + step
        safety = safety + 1

    return ticks


def ticks_generate_log(min_val: "f64", max_val: "f64") -> "list[Tick]":
    ticks = []
    if min_val <= 0.0 or max_val <= 0.0:
        return ticks

    lo = min_val
    hi = max_val
    if lo > hi:
        tmp = lo
        lo = hi
        hi = tmp

    log_min = floor(log10(lo))
    log_max = ceil(log10(hi))

    cur_exp = log_min
    while cur_exp <= log_max:
        pos = pow(10.0, cur_exp)
        if pos >= lo and pos <= hi:
            label = "10^" + str(int(cur_exp))
            ticks.append(make_tick(pos, label, 1))
        cur_exp = cur_exp + 1.0

    return ticks
