# =============================================================================
# TokenVector.Plot - Native TokenVector Graphics & Visualization Engine
# Core Module: Color, ColorMap, StyleTheme, CoordinateTransform, TicksEngine
# =============================================================================

# ----------------------------- Color (RGBA) ----------------------------------
class Color:
    r: "i32"
    g: "i32"
    b: "i32"
    a: "i32"


def make_color(r: "i32", g: "i32", b: "i32", a: "i32" = 255) -> "Color":
    c = Color()
    c.r = r
    c.g = g
    c.b = b
    c.a = a
    return c


COLOR_TRANSPARENT = make_color(0, 0, 0, 0)
COLOR_BLACK = make_color(0, 0, 0, 255)
COLOR_WHITE = make_color(255, 255, 255, 255)
COLOR_RED = make_color(235, 64, 52, 255)
COLOR_GREEN = make_color(46, 204, 113, 255)
COLOR_BLUE = make_color(52, 152, 219, 255)
COLOR_GRAY = make_color(128, 128, 128, 255)
COLOR_LIGHT_GRAY = make_color(220, 220, 220, 255)
COLOR_DARK_GRAY = make_color(50, 50, 50, 255)


def _hex_byte(hex_str: "str", start: "i32") -> "i32":
    sub = hex_str[start:start + 2].lower()
    val = 0
    for i in range(2):
        ch = sub[i]
        cval = 0
        if ch >= "0" and ch <= "9":
            cval = int(ch)
        elif ch == "a":
            cval = 10
        elif ch == "b":
            cval = 11
        elif ch == "c":
            cval = 12
        elif ch == "d":
            cval = 13
        elif ch == "e":
            cval = 14
        elif ch == "f":
            cval = 15
        val = val * 16 + cval
    return val


def color_from_hex(hex_str: "str") -> "Color":
    clean = hex_str
    if hex_str.startswith("#"):
        clean = hex_str[1:]
    ln = len(clean)
    if ln == 6:
        r = _hex_byte(clean, 0)
        g = _hex_byte(clean, 2)
        b = _hex_byte(clean, 4)
        return make_color(r, g, b, 255)
    if ln == 8:
        r = _hex_byte(clean, 0)
        g = _hex_byte(clean, 2)
        b = _hex_byte(clean, 4)
        a = _hex_byte(clean, 6)
        return make_color(r, g, b, a)
    return COLOR_BLACK


def _byte_to_hex(b: "i32") -> "str":
    v = b
    if v < 0:
        v = 0
    if v > 255:
        v = 255
    hi = v // 16
    lo = v % 16
    digits = "0123456789ABCDEF"
    return digits[hi] + digits[lo]


def color_to_hex(c: "Color") -> "str":
    return "#" + _byte_to_hex(c.r) + _byte_to_hex(c.g) + _byte_to_hex(c.b)


def color_to_rgba_str(c: "Color") -> "str":
    alpha = float(c.a) / 255.0
    return "rgba(" + str(c.r) + "," + str(c.g) + "," + str(c.b) + "," + str(alpha) + ")"


# ----------------------------- ColorMap ---------------------------------------
class ColorMap:
    name: "str"
    stops: "list[Color]"


def make_colormap(name: "str", stops: "list[Color]") -> "ColorMap":
    cm = ColorMap()
    cm.name = name
    cm.stops = stops
    return cm


def _lerp_f(a: "f64", b: "f64", t: "f64") -> "f64":
    return a + (b - a) * t


def colormap_sample(cm: "ColorMap", t: "f64") -> "Color":
    clamped_t = t
    if clamped_t < 0.0:
        clamped_t = 0.0
    if clamped_t > 1.0:
        clamped_t = 1.0
    n = len(cm.stops)
    if n == 0:
        return COLOR_BLACK
    if n == 1:
        return cm.stops[0]
    scaled = clamped_t * float(n - 1)
    idx = int(scaled)
    if idx >= n - 1:
        return cm.stops[n - 1]
    frac = scaled - float(idx)
    c1 = cm.stops[idx]
    c2 = cm.stops[idx + 1]
    r = int(_lerp_f(float(c1.r), float(c2.r), frac))
    g = int(_lerp_f(float(c1.g), float(c2.g), frac))
    b = int(_lerp_f(float(c1.b), float(c2.b), frac))
    a = int(_lerp_f(float(c1.a), float(c2.a), frac))
    return make_color(r, g, b, a)


def get_viridis_colormap() -> "ColorMap":
    stops = [
        color_from_hex("#440154"),
        color_from_hex("#482878"),
        color_from_hex("#3E4A89"),
        color_from_hex("#31688E"),
        color_from_hex("#26828E"),
        color_from_hex("#1F9E89"),
        color_from_hex("#35B779"),
        color_from_hex("#6DCD59"),
        color_from_hex("#B4DE2C"),
        color_from_hex("#FDE725"),
    ]
    return make_colormap("Viridis", stops)


