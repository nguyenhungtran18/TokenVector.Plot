# -*- coding: utf-8 -*-
# Benchmark suite for TokenVector.Plot
__tkv_import__ = ["tokenvector_plot_all"]

def bench_render() -> "str":
    # Tao tap du lieu 1000 diem
    xs = []
    ys = []
    for i in range(1000):
        fx = float(i) * 0.01
        xs.append(fx)
        ys.append(fx * fx)

    # Lap lai render 10 lan
    total_len = 0
    for iter in range(10):
        fig = make_figure(8.0, 6.0, 300.0)
        line = make_line_plot(xs, ys, "series", color_blue(), 1.5)
        ax = fig.axes
        axes2d_add_element(ax, line)
        scatter = make_scatter_plot(xs, ys, "points", color_red(), 3.0)
        axes2d_add_element(ax, scatter)
        svg = figure_to_svg(fig)
        total_len = total_len + len(svg)

    return "BENCH_OK: 10 runs of 1000-point line+scatter rendered, avg svg bytes: " + str(total_len // 10)
