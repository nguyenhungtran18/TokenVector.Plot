# -*- coding: utf-8 -*-
# Benchmark Suite for TokenVector.Plot
__tkv_import__ = ["tokenvector_plot_all"]

def bench_all() -> "str":
    # 1. Benchmark 10,000 Points Line + Scatter
    xs_10k = []
    ys_10k = []
    for i in range(10000):
        val = float(i) * 0.001
        xs_10k.append(val)
        ys_10k.append(val * val)

    fig1 = make_figure(8.0, 6.0, 300.0)
    line1 = make_line_plot(xs_10k, ys_10k, "quadratic_10k", color_blue(), 1.5)
    axes2d_add_element(fig1.axes, line1)
    pts1 = make_scatter_plot(xs_10k, ys_10k, "scatter_10k", color_red(), 2.0)
    axes2d_add_element(fig1.axes, pts1)
    svg1 = figure_to_svg(fig1)

    # 2. Benchmark Bar Plot (1,000 bars)
    xs_bar = []
    ys_bar = []
    for i in range(1000):
        xs_bar.append(float(i))
        ys_bar.append(float((i * 17) % 100))
    fig2 = make_figure(8.0, 6.0, 300.0)
    bar2 = make_bar_plot(xs_bar, ys_bar, "histogram_1k", color_green())
    axes2d_add_element(fig2.axes, bar2)
    svg2 = figure_to_svg(fig2)

    # 3. Benchmark Heatmap (100x100 = 10,000 cells)
    grid_10k = []
    for r in range(100):
        for c in range(100):
            grid_10k.append(float(r * c))
    fig3 = make_figure(8.0, 6.0, 300.0)
    hm3 = make_heatmap_plot(grid_10k, 100, 100, "heatmap_10k", color_blue())
    axes2d_add_element(fig3.axes, hm3)
    svg3 = figure_to_svg(fig3)

    return "BENCH_ALL_OK: svg1=" + str(len(svg1)) + ", svg2=" + str(len(svg2)) + ", svg3=" + str(len(svg3))
